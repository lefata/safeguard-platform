# .env.example
# Database
DATABASE_URL="postgresql://safeguard:safeguard_password@localhost:5432/safeguard"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_WORKSPACE_DOMAIN=""

# Microsoft Azure AD
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# SMTP Email
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="noreply@safeguard-platform.com"

# Storage
STORAGE_PROVIDER="vercel-blob" # or "s3"
BLOB_READ_WRITE_TOKEN=""

# AWS S3 (optional)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET="safeguard-uploads"
S3_ENDPOINT=""

# Encryption
ENCRYPTION_KEY="change-this-to-a-secure-32-char-key"

# App
NEXT_PUBLIC_URL="http://localhost:3000"
