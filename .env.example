# .env.example
# Database
# Neon pooled URL for application traffic (include ?sslmode=require)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/neondb?sslmode=require"
# Neon direct URL for Prisma migrations (include ?sslmode=require)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require"

# Auth.js (use a unique, high-entropy value in every environment)
AUTH_SECRET="generate-a-32-byte-random-secret"
# Backwards-compatible alias; AUTH_SECRET takes precedence.
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_WORKSPACE_DOMAIN=""

# Microsoft Azure AD
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# SMTP Email
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="noreply@safeguard-platform.com"

# Storage
STORAGE_PROVIDER="vercel-blob" # or "s3"
BLOB_READ_WRITE_TOKEN=""

# AWS S3 (optional)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_BUCKET="safeguard-uploads"
S3_ENDPOINT=""

# Encryption
ENCRYPTION_KEY="change-this-to-a-secure-32-char-key"

# One-time first-admin bootstrap (run locally; never add these to Vercel)
ALLOW_BOOTSTRAP_ADMIN="true"
BOOTSTRAP_TENANT_NAME="Your School Name"
BOOTSTRAP_TENANT_SLUG="your-school"
BOOTSTRAP_ADMIN_NAME="Platform Administrator"
BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
BOOTSTRAP_ADMIN_PASSWORD="use-a-unique-password-with-at-least-12-characters"

# App
NEXT_PUBLIC_URL="http://localhost:3000"
